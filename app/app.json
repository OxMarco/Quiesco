{
  "expo": {
    "name": "Quiesco",
    "slug": "quiesco",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quiesco",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "rest.quiesco.app",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "appleTeamId": "HDP6U6R2Y6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "rest.quiesco.app",
      "adaptiveIcon": {
        "backgroundColor": "#2F6468",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F6468",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0F1718",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "react-native-ble-manager",
        {
          "isBleRequired": true,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "Quiesco uses Bluetooth to read your sensor and download its night-time readings."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-mail-composer"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
