---
import { clock, EVENTS, sampleNight, summarize } from '../lib/night';

const pts = sampleNight();
const night = summarize(pts, 1000);

// Chart geometry: 22:00–07:00 across, 400–1,400 ppm up.
// The viewBox is about as wide as the chart on a desktop, so 1 unit ≈ 1 px there.
const W = 1000, H = 420, L = 52, R = 16, T = 16, B = 40;
const Y0 = 400, Y1 = 1400;
const sx = (h: number) => L + (h / 9) * (W - L - R);
const sy = (v: number) => T + (1 - (v - Y0) / (Y1 - Y0)) * (H - T - B);
const line = pts.map((p, i) => `${i ? 'L' : 'M'}${sx(p.h).toFixed(1)} ${sy(p.v).toFixed(1)}`).join('');
const area = `${line}L${sx(9)} ${sy(Y0)}L${sx(0)} ${sy(Y0)}Z`;
const grid = [400, 800, 1000, 1400];
const hours = [
  { h: 0, label: '22:00', anchor: 'start' },
  { h: 3, label: '01:00', anchor: 'middle' },
  { h: 6, label: '04:00', anchor: 'middle' },
  { h: 9, label: '07:00', anchor: 'end' },
];
const fmt = (n: number) => n.toLocaleString('en');

// The line takes DRAW seconds to cross the night; each marker appears as the line reaches it.
const DRAW = 5;
const at = (h: number) => `--d:${((h / 9) * DRAW).toFixed(2)}s`;

// The sleep window bar runs from noon to noon. Judging starts an hour before bedtime.
const BED = 23, WAKE = 7;
const noon = (clockH: number) => `${((((clockH - 12 + 24) % 24) / 24) * 100).toFixed(2)}%`;
---

<section id="app">
  <div class="head">
    <div>
      <p class="eyebrow">The app</p>
      <h2>Sync in the morning. See how the night went</h2>
    </div>
    <p>Each night opens with what went wrong and when. Tap a reading for its chart and the research behind the range.</p>
  </div>

  <div class="card night">
    <div class="bar">
      <p class="title">Nights</p>
      <p class="sub">Sample night, generated · bedtime 23:00, wake 07:00</p>
      <button type="button" class="replay" hidden>
        <svg viewBox="0 0 24 24" class="icon" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4h4"></path></svg>
        Replay the night
      </button>
    </div>
    <div class="plot" style={`--draw:${DRAW}s`}>
      <svg
        class="chart"
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label={`CO₂ in parts per million from 22:00 to 07:00. It passes 1,000 ppm at ${night.from} and peaks at ${fmt(night.peak.v)} ppm.`}
      >
        <rect x={L} y={sy(1400)} width={W - L - R} height={sy(1000) - sy(1400)} class="zone-bad" />
        <rect x={L} y={sy(1000)} width={W - L - R} height={sy(800) - sy(1000)} class="zone-warn" />
        {
          grid.map((v) => (
            <>
              <line x1={L} x2={W - R} y1={sy(v)} y2={sy(v)} class="grid" />
              <text x={L - 6} y={sy(v) + 4} text-anchor="end">{fmt(v)}</text>
            </>
          ))
        }
        <text x={W - R - 6} y={sy(1400) + 20} text-anchor="end" class="lbl bad">Bad</text>
        <text x={sx(EVENTS.windowOpened) - 10} y={sy(800) - 10} text-anchor="end" class="lbl warn">Stuffy</text>
        {hours.map((t) => <text x={sx(t.h)} y={H - 12} text-anchor={t.anchor}>{t.label}</text>)}
        <path d={area} class="area" />
        <path d={line} class="line" pathLength="1" />
        <g class="pop" style={at(EVENTS.doorShut)}>
          <line x1={sx(EVENTS.doorShut)} x2={sx(EVENTS.doorShut)} y1={sy(840)} y2={sy(Y0)} class="event" />
          <text x={sx(EVENTS.doorShut) + 6} y={sy(Y0) - 10} class="ev">Door shut</text>
        </g>
        <g class="pop" style={at(night.first.h)}>
          <circle cx={sx(night.first.h)} cy={sy(1000)} r="5" class="cross" />
          <text x={sx(night.first.h) + 12} y={sy(1000) + 24} class="ev">Passed 1,000 ppm · {night.from}</text>
        </g>
        <g class="pop" style={at(EVENTS.windowOpened)}>
          <line x1={sx(EVENTS.windowOpened)} x2={sx(EVENTS.windowOpened)} y1={sy(night.peak.v) + 8} y2={sy(Y0)} class="event" />
          <circle cx={sx(night.peak.h)} cy={sy(night.peak.v)} r="5.5" class="peak" />
          <text x={sx(EVENTS.windowOpened) - 6} y={sy(Y0) - 10} text-anchor="end" class="ev">
            Window opened · {clock(EVENTS.windowOpened)}
          </text>
        </g>
      </svg>
      <div class="story pop" style={`--d:${DRAW + 0.2}s`}>
        <p class="verdict">
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M8 4.2v4.6M8 11.2v.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
          Stuffy night
        </p>
        <p>
          Over <span class="num">1,000 ppm</span> for <span class="num">{night.duration}</span>, peaking at{' '}
          <span class="num">{fmt(night.peak.v)} ppm</span>. Leave the door ajar tonight.
        </p>
      </div>
    </div>
  </div>

  <div class="tiles">
    <div class="card">
      <div class="art link" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="icon big"><rect x="4" y="4" width="16" height="16" rx="4"></rect><path d="M9 10.5q1.5 1.5 3 0"></path></svg>
        <span class="dash"></span>
        <svg viewBox="0 0 24 24" class="icon"><path d="M7 7l10 10-5 5V2l5 5L7 17"></path></svg>
        <span class="dash"></span>
        <svg viewBox="0 0 24 24" class="icon big"><rect x="6" y="2" width="12" height="20" rx="3"></rect><path d="M11 18h2"></path></svg>
      </div>
      <h3>Bluetooth to your phone. That's it</h3>
      <p>No account, no Wi-Fi, no server. Nobody else sees how you sleep.</p>
    </div>

    <div class="card">
      <div class="art" aria-hidden="true">
        <div class="window">
          <span class="judged" style={`left:${noon(BED - 1)};right:calc(100% - ${noon(WAKE)})`}></span>
          <span class="bed" style={`left:${noon(BED)}`}></span>
        </div>
        <div class="hours"><span>12:00</span><span>18:00</span><span>00:00</span><span>06:00</span><span>12:00</span></div>
      </div>
      <h3>Judged by your sleep window</h3>
      <p>From an hour before bed until you wake. By day, only unhealthy CO₂ or noise.</p>
    </div>

    <div class="card">
      <div class="art drill" aria-hidden="true">
        <div class="lines"><span class="hot"></span><span></span><span class="short"></span></div>
        <svg viewBox="0 0 24 24" class="icon"><path d="M9 6l6 6-6 6"></path></svg>
        <svg viewBox="0 0 60 40" class="spark"><path d="M2 34L14 30L24 18L34 12L46 8L58 20"></path></svg>
      </div>
      <h3>One sentence, then the detail</h3>
      <p>Tap a reading for its full chart and the research behind the range.</p>
    </div>
  </div>
</section>

<script>
  import { playWhenSeen, reducedMotion, replay } from '../lib/inview';

  const card = document.querySelector<HTMLElement>('#app .night')!;
  const button = card.querySelector<HTMLButtonElement>('.replay')!;
  if (!reducedMotion()) {
    playWhenSeen([card]);
    button.hidden = false;
    button.addEventListener('click', () => replay(card));
  }
</script>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 20px;
  }
  .night {
    border-radius: 28px;
    padding: 24px;
    box-shadow: var(--shadow);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 20px;
  }
  .title {
    font-family: var(--display);
    font-size: 24px;
  }
  .sub {
    flex: 1;
    font-size: 13px;
    color: var(--muted);
  }
  .replay {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--tide);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }
  .replay:hover {
    border-color: var(--tide);
  }
  .replay[hidden] {
    display: none;
  }
  .replay .icon {
    width: 18px;
    height: 18px;
  }
  .plot {
    position: relative;
    margin-top: 12px;
  }
  .chart {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .chart text {
    font-family: var(--text);
    font-size: 12px;
    fill: var(--muted);
  }
  .chart .lbl {
    font-weight: 600;
  }
  .chart .lbl.bad {
    fill: var(--bad);
  }
  .chart .lbl.warn {
    fill: var(--warn);
  }
  .chart .ev {
    font-weight: 500;
    fill: var(--ink);
  }
  .grid {
    stroke: var(--line);
  }
  .zone-bad {
    fill: var(--bad);
    opacity: 0.09;
  }
  .zone-warn {
    fill: var(--warn);
    opacity: 0.1;
  }
  .area {
    fill: var(--tide);
    opacity: 0.12;
  }
  .line {
    fill: none;
    stroke: var(--tide);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-dasharray: 1;
  }
  .event {
    stroke: var(--muted);
    stroke-dasharray: 3 3;
  }
  .cross {
    fill: var(--bad);
  }
  .peak {
    fill: var(--tide);
    stroke: var(--surface);
    stroke-width: 2;
  }
  .story {
    position: absolute;
    left: 7%;
    top: 4%;
    max-width: 300px;
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 16px 32px -16px rgba(30, 43, 45, 0.35);
    font-size: 15px;
    line-height: 1.5;
  }
  .verdict {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--bad);
    font-size: 14px;
    margin-bottom: 4px;
  }
  .verdict svg {
    width: 16px;
    height: 16px;
    flex: none;
  }

  /* Held at the start until the card is seen, then the night plays out. */
  .armed:not(.inview) .line {
    stroke-dashoffset: 1;
  }
  .armed:not(.inview) .area,
  .armed:not(.inview) .pop {
    opacity: 0;
  }
  .inview .line {
    animation: draw var(--draw) linear both;
  }
  .inview .area {
    animation: fade-in 0.8s ease-out var(--draw) both;
  }
  .inview .pop {
    animation: pop 0.45s ease-out var(--d) both;
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 14px;
    margin-top: 14px;
  }
  .tiles h3 {
    margin-top: 12px;
    font-family: var(--text);
    font-size: 16px;
    font-weight: 600;
  }
  .tiles p {
    margin-top: 2px;
    font-size: 14px;
    color: var(--muted);
  }
  .art {
    height: 64px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--tide);
  }
  .link {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .link .icon {
    width: 28px;
    height: 28px;
  }
  .link .big {
    width: 34px;
    height: 34px;
  }
  .dash {
    width: 52px;
    border-top: 2px dashed currentColor;
    opacity: 0.6;
  }
  .window {
    position: relative;
    height: 18px;
    border-radius: 9px;
    overflow: hidden;
    background: repeating-linear-gradient(135deg, var(--line) 0 2px, var(--bg) 2px 6px);
  }
  .judged {
    position: absolute;
    top: 0;
    bottom: 0;
    background: var(--tide);
    border-radius: 9px;
  }
  .bed {
    position: absolute;
    top: 3px;
    bottom: 3px;
    width: 2px;
    background: var(--surface);
  }
  .hours {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    font-size: 11px;
    color: var(--muted);
  }
  .drill {
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }
  .lines {
    flex: 1;
    display: grid;
    gap: 6px;
  }
  .lines span {
    height: 8px;
    border-radius: 4px;
    background: var(--line);
  }
  .lines .hot {
    width: 70%;
    background: var(--bad);
  }
  .lines .short {
    width: 85%;
  }
  .drill .icon {
    width: 22px;
    height: 22px;
  }
  .spark {
    width: 64px;
    height: 40px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  /* The chart shrinks with the page, so its text and strokes grow in viewBox units to stay readable. */
  @media (max-width: 1000px) {
    .chart text {
      font-size: 15px;
    }
  }
  @media (max-width: 760px) {
    .chart text {
      font-size: 19px;
    }
    .line {
      stroke-width: 4;
    }
  }
  @media (max-width: 860px) {
    .story {
      position: static;
      max-width: none;
      margin-top: 14px;
      box-shadow: none;
    }
  }
  /* On a phone the chart is too small for its notes; the markers stay. */
  @media (max-width: 640px) {
    .night {
      padding: 18px 14px;
    }
    .chart text {
      font-size: 32px;
    }
    .line {
      stroke-width: 6;
    }
    .grid,
    .event {
      stroke-width: 2.5;
    }
    .chart .ev {
      display: none;
    }
  }
</style>
