---
import { bentoSvg, readoutHtml, SCENES, type SceneId } from '../lib/bento';

const initial: SceneId = 'stuffy';
const scene = SCENES[initial].reading;
---

<div class="stage">
  <div class="device" role="img" aria-label="The Quiesco unit showing its readings on the e-ink screen">
    <div class="glass">
      <svg viewBox="0 0 152 152" aria-hidden="true" set:html={bentoSvg(scene, false)} />
    </div>
  </div>
  <div class="scenes" role="group" aria-label="Try a room">
    {
      (Object.keys(SCENES) as SceneId[]).map((id) => (
        <button type="button" data-scene={id} aria-pressed={id === initial ? 'true' : 'false'}>
          {SCENES[id].label}
        </button>
      ))
    }
  </div>
  <p class="readout" aria-live="polite" set:html={readoutHtml(scene)} />
</div>

<script>
  import { bentoSvg, readoutHtml, SCENES, type SceneId } from '../lib/bento';
  import { reducedMotion } from '../lib/inview';
  import { usesFahrenheit } from '../lib/units';

  const fahrenheit = usesFahrenheit();
  const glass = document.querySelector<HTMLElement>('.stage .glass')!;
  const panel = glass.querySelector('svg')!;
  const readout = document.querySelector<HTMLElement>('.stage .readout')!;
  const buttons = document.querySelectorAll<HTMLButtonElement>('.stage .scenes button');

  function show(id: SceneId, flash: boolean) {
    const s = SCENES[id].reading;
    panel.innerHTML = bentoSvg(s, fahrenheit);
    readout.innerHTML = readoutHtml(s);
    if (flash) {
      // An e-ink refresh blinks the panel once.
      glass.classList.remove('flash');
      void glass.offsetWidth;
      glass.classList.add('flash');
    }
  }

  function press(b: HTMLButtonElement) {
    buttons.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    show(b.dataset.scene as SceneId, true);
  }

  // The unit walks through the rooms on its own while it is on screen, until the
  // visitor picks one.
  let timer = 0;
  let picked = false;
  const stop = () => clearInterval(timer);
  const start = () => {
    stop();
    if (picked) return;
    timer = window.setInterval(() => {
      const i = [...buttons].findIndex((b) => b.getAttribute('aria-pressed') === 'true');
      press(buttons[(i + 1) % buttons.length]);
    }, 4200);
  };
  if (!reducedMotion()) {
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0.5 }).observe(glass);
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      picked = true;
      stop();
      press(b);
    }),
  );
  if (fahrenheit) {
    const pressed = document.querySelector<HTMLButtonElement>('.stage .scenes [aria-pressed="true"]');
    show((pressed?.dataset.scene ?? 'stuffy') as SceneId, false);
  }
</script>

<style>
  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  /* The outer radius is the glass radius plus the bezel, so the corners are concentric. */
  .device {
    --bezel: clamp(28px, 11%, 40px);
    --r: 14px;
    width: min(340px, 100%);
    aspect-ratio: 1;
    padding: var(--bezel);
    background: var(--chassis);
    border: 1px solid var(--chassis-edge);
    border-radius: calc(var(--r) + var(--bezel));
    box-shadow: var(--shadow);
    display: grid;
  }
  .glass {
    width: 100%;
    height: 100%;
    background: var(--paper);
    border-radius: var(--r);
    box-shadow:
      inset 0 0 0 1px rgba(30, 43, 45, 0.12),
      inset 0 2px 6px rgba(30, 43, 45, 0.12);
    overflow: hidden;
  }
  .glass svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .glass.flash {
    animation: eink 0.5s steps(2);
  }
  @keyframes eink {
    0% {
      filter: invert(1);
    }
    50%,
    100% {
      filter: invert(0);
    }
  }
  .scenes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }
  .scenes button {
    font: inherit;
    font-size: 14px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .scenes button[aria-pressed='true'] {
    border-color: var(--tide);
    background: var(--tide);
    color: var(--on-tide);
  }
  .readout {
    font-size: 14px;
    color: var(--muted);
    min-height: 2.5em;
    text-align: center;
  }
  .readout :global(.flag) {
    font-weight: 600;
  }
  .readout :global(.flag.warn) {
    color: var(--warn);
  }
  .readout :global(.flag.bad) {
    color: var(--bad);
  }
</style>
