    </div>
    <a class="btn primary get" href={LINKS.campaign}>Get yours</a>
  </div>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 22px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
  }
  .brand svg {
    width: 36px;
    height: 36px;
    display: block;
  }
  .brand span {
    font-family: var(--display);
    font-weight: 300;
    font-size: 26px;
    letter-spacing: 0.01em;
  }
  .right {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .links {
    display: flex;
    list-style: none;
    margin: 0 8px 0 0;
    padding: 0;
  }
  .links a {
    display: block;
    padding: 10px 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--ink);
  }
  .get {
    margin-left: 6px;
    padding: 10px 18px;
    font-size: 15px;
  }
  @media (max-width: 760px) {
    .links {
      display: none;
    }
  }
  .social {
    display: flex;
    gap: 6px;
  }
  @media (max-width: 440px) {
    .social {
      display: none;
    }
  }
  .social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--muted);
  }
  .social a:hover {
    color: var(--ink);
    background: var(--raised);
  }
  .social svg {
    width: 19px;
    height: 19px;
  }
</style>
