---
import { LINKS } from '../site';
---

<nav aria-label="Quiesco">
  <a class="brand" href="/" aria-label="Quiesco home">
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <rect width="100" height="100" rx="22.5" fill="#2F6468"></rect>
      <rect x="21" y="21" width="58" height="58" rx="14" fill="#EEE8DC"></rect>
      <path d="M34 46q6 6 12 0M54 46q6 6 12 0M42 60q8 6 16 0" fill="none" stroke="#1E2B2D" stroke-width="5" stroke-linecap="round"></path>
    </svg>
    <span>Quiesco</span>
  </a>
  <div class="social">
    <a href={LINKS.x} aria-label="Quiesco on X">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L2.8 2h6.4l4.4 5.9L18.9 2zm-1.1 18.1h1.7L7.3 3.8H5.5l12.3 16.3z"></path></svg>
    </a>
    <a href={LINKS.github} aria-label="Quiesco on GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.9 10.9c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"></path></svg>
    </a>
    <a href={LINKS.kickstarter} aria-label="Quiesco on Kickstarter">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7.168 0c-3.2 0-5.797 2.579-5.797 5.758v12.484C1.371 21.42 3.968 24 7.168 24c1.981 0 3.716-.978 4.768-2.479l.794.79c2.26 2.245 5.943 2.245 8.203 0a5.724 5.724 0 001.696-4.075 5.724 5.724 0 00-1.696-4.074l-2.182-2.168 2.182-2.156a5.724 5.724 0 001.696-4.074 5.724 5.724 0 00-1.696-4.074c-2.26-2.246-5.942-2.246-8.203 0l-.794.789A5.797 5.797 0 007.168 0Z"></path></svg>
    </a>
  </div>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 22px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
  }
  .brand svg {
    width: 36px;
    height: 36px;
    display: block;
  }
  .brand span {
    font-family: var(--display);
    font-weight: 300;
    font-size: 26px;
    letter-spacing: 0.01em;
  }
  .social {
    display: flex;
    gap: 6px;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--muted);
  }
  .social a:hover {
    color: var(--ink);
    background: var(--raised);
  }
  .social svg {
    width: 19px;
    height: 19px;
  }
</style>
