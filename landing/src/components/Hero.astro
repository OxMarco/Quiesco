---
import { LINKS } from '../site';
import UnitDemo from './UnitDemo.astro';

// Icon paths on a 24 × 24 stroke grid.
const pillars = [
  { label: 'Made for sleep', icon: '<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>' },
  { label: 'Five sensors', icon: '<path d="M3 12h4l2-6 4 12 2-6h6"/>' },
  { label: 'Open source, GPLv3', icon: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/>' },
  { label: 'Costs less, does more', icon: '<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="7.5" r="1.2"/>' },
];
---

<header class="hero">
  <div>
    <p class="eyebrow">Open-source bedroom environment monitor</p>
    <h1>Measure your bedroom. <em>Sleep better in it</em></h1>
    <p class="lede">Five sensors, judged against sleep research. When something is off, it tells you the fix.</p>
    <ul class="pillars">
      {
        pillars.map((p) => (
          <li>
            <svg viewBox="0 0 24 24" class="icon" aria-hidden="true" set:html={p.icon} />
            {p.label}
          </li>
        ))
      }
    </ul>
    <div class="ctas">
      <a class="btn primary" href={LINKS.campaign}>Get yours</a>
      <a class="btn ghost" href={LINKS.buildYourOwn}>Build your own</a>
    </div>
  </div>
  <UnitDemo />
</header>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
    padding-block: 40px 80px;
  }
  h1 {
    margin-top: 14px;
    font-size: clamp(36px, 5.2vw, 60px);
    font-weight: 300;
    letter-spacing: -0.01em;
  }
  h1 em {
    font-style: normal;
    color: var(--tide);
    font-weight: 400;
  }
  .lede {
    margin-top: 18px;
    max-width: 26em;
  }
  .pillars {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .pillars li {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px 8px 10px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    font-size: 15px;
    font-weight: 500;
  }
  .pillars .icon {
    width: 20px;
    height: 20px;
    color: var(--tide);
  }
  .ctas {
    margin-top: 32px;
  }
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 44px;
      padding-block: 24px 56px;
    }
  }
</style>
