---
import { LINKS } from '../site';
---

<div class="end">
  <h2>A calmer bedroom, one reading at a time</h2>
  <div class="ctas">
    <a class="btn primary" href={LINKS.campaign}>Get yours</a>
    <a class="btn ghost" href={LINKS.buildYourOwn}>Build your own</a>
  </div>
  <p class="legal">
    <a href={LINKS.privacy}>Privacy policy</a> · <a href={LINKS.support}>Contact</a>
  </p>
</div>

<style>
  .end {
    padding-block: 80px 72px;
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 300;
    max-width: 16em;
  }
  .ctas {
    margin-top: 26px;
  }
  .legal {
    margin-top: 48px;
    font-size: 14px;
    color: var(--muted);
  }
</style>
