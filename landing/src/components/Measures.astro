---
// Night references from app/src/ui/references.ts, drawn on the panel's gauge
// scales (firmware/UI.md §4, Ledger). Temperatures carry data-c so the page can
// show them in °F.

interface Row {
  name: string;
  part: string;
  lo: number;
  hi: number;
  okLo: number;
  okHi: number;
  range: string;
  unit: string;
  ticks: string[];
  title: string;
  body: string;
}

const t = (c: number) => `<span data-c="${c}">${c}</span>`;
const deg = (s: string) => `<span data-deg>${s}</span>`;

const rows: Row[] = [
  {
    name: 'CO₂', part: 'Sensirion SCD41', lo: 400, hi: 2000, okLo: 400, okHi: 800,
    range: 'under 800', unit: 'ppm', ticks: ['400', '1,200', '2,000'],
    title: 'Stuffy air',
    body: 'Sleep studies see worse sleep from a night average of 1,000 ppm. Open a window or leave the door ajar.',
  },
  {
    name: 'Temperature', part: 'Sensirion SCD41', lo: 10, hi: 35, okLo: 16, okHi: 20,
    range: `${t(16)} – ${t(20)}`, unit: `${deg('°C')} at night`, ticks: [t(10), t(22.5), t(35)],
    title: 'Too warm to sleep well',
    body: `Sleep efficiency falls above ${t(25)} ${deg('°C')}. Turn the heating down or use a lighter duvet.`,
  },
  {
    name: 'Humidity', part: 'Sensirion SCD41', lo: 0, hi: 100, okLo: 40, okHi: 60,
    range: '40 – 60', unit: '%', ticks: ['0', '50', '100'],
    title: 'Dry airways or damp walls',
    body: 'Under 30 % dries your throat, over 70 % favours mould. Use a humidifier or ventilate.',
  },
  {
    // log₁₀ lux over 1–10,000; the band is "1 lux or less".
    name: 'Light', part: 'Vishay VEML7700', lo: 0, hi: 4, okLo: 0, okHi: 0,
    range: '1 or less', unit: 'lux asleep', ticks: ['1', '100', '10,000'],
    title: 'Too bright',
    body: 'Light while asleep disturbs your body clock. Try blackout curtains or a sleep mask.',
  },
  {
    name: 'Noise', part: 'SPH0641 microphone', lo: 30, hi: 100, okLo: 30, okHi: 45,
    range: 'under 45', unit: 'dB peaks, 30 dB average', ticks: ['30', '65', '100'],
    title: 'Too loud',
    body: "Single sounds over 45 dB wake the brain even when you don't notice. Try earplugs or close the window.",
  },
];

const x = (r: Row, v: number) => 4 + ((v - r.lo) / (r.hi - r.lo)) * 292;
const band = (r: Row) => {
  const x1 = x(r, r.okLo);
  return { x: x1, w: Math.max(x(r, r.okHi) - x1, 6) };
};
---

<section id="measures">
  <div class="head">
    <div>
      <p class="eyebrow">What it measures</p>
      <h2>Five readings, each with something you can do about it</h2>
    </div>
    <p>
      General air monitors report a number and leave the rest to you. Quiesco judges your bedroom against what sleep
      research asks of it, and when a reading is off it tells you the fix.
    </p>
  </div>

  <div class="ledger">
    {
      rows.map((r) => (
        <div class="row">
          <div>
            <h3>{r.name}</h3>
            <p class="part">{r.part}</p>
          </div>
          <div class="gauge">
            <p class="range num">
              <Fragment set:html={r.range} />
              <small set:html={r.unit} />
            </p>
            <svg viewBox="0 0 300 22" preserveAspectRatio="none" aria-hidden="true">
              <line x1="4" y1="11" x2="296" y2="11" class="track" />
              <rect x={band(r).x} y="8" width={band(r).w} height="6" rx="3" class="band" />
            </svg>
            <div class="scale">
              {r.ticks.map((tick) => <span set:html={tick} />)}
            </div>
          </div>
          <p class="act">
            <b>{r.title}</b>
            <Fragment set:html={r.body} />
          </p>
        </div>
      ))
    }
  </div>
  <p class="note">
    The ranges shown are the references the app uses for the night. Temperature and humidity are comfort, which varies
    from person to person; noise follows the WHO night noise guidelines, CO₂ follows ventilation research and Health
    Canada's residential limit. By day the app only judges CO₂ and noise.
  </p>
</section>

<style>
  .ledger {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 170px 1fr 1.15fr;
    gap: 28px;
    padding-block: 24px;
    border-bottom: 1px solid var(--line);
    align-items: center;
  }
  h3 {
    font-family: var(--text);
    font-size: 18px;
    font-weight: 600;
  }
  .part {
    font-size: 13px;
    color: var(--muted);
    margin-top: 2px;
  }
  .range {
    font-size: 22px;
    color: var(--tide);
  }
  .range small {
    font-family: var(--text);
    font-weight: 500;
    font-size: 13px;
    color: var(--muted);
    margin-left: 6px;
  }
  svg {
    display: block;
    width: 100%;
    height: 22px;
    margin-top: 6px;
    overflow: visible;
  }
  .track {
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-dasharray: 1.5 4;
    stroke-linecap: round;
    opacity: 0.7;
  }
  .band {
    fill: var(--tide);
  }
  .scale {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .act {
    font-size: 15px;
    color: var(--muted);
  }
  .act b {
    display: block;
    color: var(--ink);
    font-weight: 600;
    margin-bottom: 2px;
  }
  .note {
    font-size: 14px;
    color: var(--muted);
    margin-top: 22px;
    max-width: 52em;
  }
  @media (max-width: 860px) {
    .row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
